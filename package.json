{
  "name": "ai-todo",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "轻盈的桌面待办与通知解析工具",
  "author": "AI Todo contributors",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web:dev": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "test": "node --test tests/unit/*.test.js",
    "test:desktop": "npm run build && playwright test",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
